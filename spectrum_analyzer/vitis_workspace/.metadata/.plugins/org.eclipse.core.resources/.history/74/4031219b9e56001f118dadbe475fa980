#define ADDR_SET_PHASE_OFFSET XPAR_AXI_GPIO_DDS_CONFIG_BASEADDR
#define M 1000000	// 10^6 Mega
#define DDS_FREQ (100 * M)
#define DDS_OUTPUT_BITS 16


#define MAX_FFT_SIZE 1024 // Defined in RTL


#define DDR_DATA_TRIGGER XPAR_AXI_GPIO_DATATRIGGER_BASEADDR

// Function to set the frequency of DDS //
//////////////////////////////////////////

uint8_t set_dds_freq(uint64_t freq, uint32_t phase_offset){

	uint64_t pinc;
	uint16_t poff;
	uint32_t data;

	pinc = ((freq * (1 << DDS_OUTPUT_BITS)) / DDS_FREQ);

	poff = 0;

	data = ((uint32_t)poff << 16) | ((uint32_t)pinc);

	Xil_Out32(ADDR_SET_PHASE_OFFSET, data);
	Xil_Out32(ADDR_SET_PHASE_OFFSET, 0);
	Xil_Out32(ADDR_SET_PHASE_OFFSET, data);

	PRINT("pinc: %"PRIu16"\n\r", (uint16_t)pinc);
	PRINT("set_dds_freq: %"PRIu16"\n\r", (uint16_t)data);

	return 1;
}

