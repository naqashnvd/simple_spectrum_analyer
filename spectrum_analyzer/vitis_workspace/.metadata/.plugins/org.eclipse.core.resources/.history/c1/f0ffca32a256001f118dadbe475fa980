#define ADDR_SET_PHASE_OFFSET XPAR_AXI_GPIO_DDS_CONFIG_BASEADDR
#define M 1000000	// 10^6 Mega
#define DDS_FREQ (100 * M)
#define DDS_OUTPUT_BITS 16


#define ADDR_SET_DDR_DATA_TRIGGER XPAR_AXI_GPIO_DATATRIGGER_BASEADDR

#define ADDR_SET_XFFT_CONFIG XPAR_AXI_GPIO_XFFT_CONFIG_BASEADDR
#define MAX_FFT_SIZE 1024 // Defined in RTL


// Function to set the frequency of DDS //
//////////////////////////////////////////

uint8_t set_dds_freq(uint64_t freq, uint32_t phase_offset){

	uint64_t pinc;
	uint16_t poff;
	uint32_t data;

	pinc = ((freq * (1 << DDS_OUTPUT_BITS)) / DDS_FREQ);

	poff = 0;

	data = ((uint32_t)poff << 16) | ((uint32_t)pinc);

	Xil_Out32(ADDR_SET_PHASE_OFFSET, data);
	Xil_Out32(ADDR_SET_PHASE_OFFSET, 0);
	Xil_Out32(ADDR_SET_PHASE_OFFSET, data);

	PRINT("pinc: %"PRIx16"\n\r", (uint16_t)pinc);
	PRINT("set_dds_freq: %"PRIx16"\n\r", (uint16_t)data);

	return 1;
}

// Function to Set FFT config //
////////////////////////////////

uint8_t set_xfft_config(){
	// in RTL
	// FFT Size = 1024
	// CP_LEN = Disabled
	// Channel = 1

	uint8_t NFFT = 9; 		// Log2(512)
	uint8_t FWD_INV = 1;	// 1 Channel FFT
	uint16_t SCALE_SCH = 2*(NFFT/2); 	// 2*CEIL(NFFT/2);

	uint32_t data;

	data = 0;
	data |= NFFT & 0x1F;
	data |= (uint16_t)((FWD_INV & 0x1) << 8);
	data |= (uint32_t)(SCALE_SCH << 9);


	PRINT("set_xfft_config: %"PRIx32"\n\r", (uint32_t)data);

	Xil_Out32(XPAR_AXI_GPIO_XFFT_CONFIG_BASEADDR, data);

	// Set the maxCOunt for packetizer
	Xil_Out16(XPAR_AXI_GPIO_XFFT_CONFIG_BASEADDR + XGPIO_DATA2_OFFSET, (1 << NFFT));

	return 1;
}



// MAIN //
//////////
int main()
{
    init_platform();

    set_dds_freq(1*M, 0);


    print("Hello World\n\r");

    print("Configure the FFT Core\n\r");
    set_xfft_config();

    while(1){
    	print("Enter any key\n\r");
        getchar();
    	// Trigger Data to FFT
    	Xil_Out32(ADDR_SET_DDR_DATA_TRIGGER, 0);
    	Xil_Out32(ADDR_SET_DDR_DATA_TRIGGER, 1);
    }

    cleanup_platform();
    return 0;
}
